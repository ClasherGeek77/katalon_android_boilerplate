<?xml version="1.0" encoding="UTF-8"?>
<GlobalVariableEntities>
   <description>the local flutter app on the android9 AVD</description>
   <name>default</name>
   <tag></tag>
   <defaultProfile>true</defaultProfile>
   <GlobalVariableEntity>
      <description>debug apk of the app under test, fetched by ./fetch_app.sh</description>
      <initValue>com.kms.katalon.core.configuration.RunConfiguration.getProjectDir() + '/apps/ted_mobile_app_test-v1.0.0-debug.apk'</initValue>
      <name>APK_PATH</name>
   </GlobalVariableEntity>
</GlobalVariableEntities>
